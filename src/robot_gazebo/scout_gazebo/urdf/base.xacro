<?xml version="1.0"?>
<robot name="scout_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="gpu" default="false"/>
  <xacro:arg name="lidar_samples" default="720"/>
  <xacro:property name="M_PI" value="3.141592653589793"/>
  <xacro:property name="base_x_size" value="0.925"/>
  <xacro:property name="base_y_size" value="0.380"/>
  <xacro:property name="base_z_size" value="0.210"/>
  <xacro:property name="wheelbase" value="0.498"/>
  <xacro:property name="track" value="0.58306"/>
  <xacro:property name="wheel_vertical_offset" value="-0.0702"/>
  <xacro:property name="wheel_length" value="0.11653"/>
  <xacro:property name="wheel_radius" value="0.16459"/>
  <xacro:include filename="$(find scout_gazebo)/urdf/inertial.xacro"/>
  <xacro:include filename="$(find scout_gazebo)/urdf/scout_wheel_type1.xacro"/>
  <xacro:include filename="$(find scout_gazebo)/urdf/scout_wheel_type2.xacro"/>

  <!-- Ground projection is the root; the body is above the wheel contact plane. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius - wheel_vertical_offset}"/>
  </joint>
  <link name="base_link">
    <inertial>
      <mass value="40"/>
      <inertia ixx="2.288641" ixy="0" ixz="0" iyy="5.103976" iyz="0" izz="3.431465"/>
    </inertial>
    <visual>
      <geometry><mesh filename="file://$(find scout_gazebo)/meshes/base_link.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.0008"/>
      <geometry><box size="${base_x_size} ${base_y_size} ${base_z_size}"/></geometry>
    </collision>
  </link>
  <xacro:scout_wheel_type1 wheel_prefix="front_right">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0"/>
  </xacro:scout_wheel_type1>
  <xacro:scout_wheel_type2 wheel_prefix="front_left">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}"/>
  </xacro:scout_wheel_type2>
  <xacro:scout_wheel_type1 wheel_prefix="rear_left">
    <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}"/>
  </xacro:scout_wheel_type1>
  <xacro:scout_wheel_type2 wheel_prefix="rear_right">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0"/>
  </xacro:scout_wheel_type2>

  <xacro:include filename="$(find scout_gazebo)/urdf/laser_support.xacro"/>
  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
  <xacro:VLP-16 parent="support" name="velodyne" topic="/velodyne_points"
      hz="10" samples="$(arg lidar_samples)" min_range="0.2" max_range="20.0" gpu="$(arg gpu)">
    <origin xyz="0 0 ${support_length/2}"/>
  </xacro:VLP-16>
  <xacro:include filename="$(find realsense_ros_gazebo)/xacro/depthcam.xacro"/>
  <xacro:realsense_d435 sensor_name="camera" parent_link="base_link" rate="15.0">
    <origin xyz="0.25 0 0.25"/>
  </xacro:realsense_d435>
  <xacro:include filename="$(find scout_gazebo)/urdf/imu.xacro"/>
  <xacro:imu sensor_name="imu" parent_link="base_link">
    <origin xyz="-0.03 0 ${base_z_size/2}"/>
  </xacro:imu>
  <xacro:include filename="$(find scout_gazebo)/urdf/move.xacro"/>
</robot>
